# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings > API in the Supabase dashboard)
# Leave both empty during development: the app falls back to demo fixtures
# in src/lib/demo/fixtures.ts and every page stays fully browsable, but the
# admin dashboard requires these to be set (auth needs a real project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: NEVER exposed to the client, NEVER used by the app at
# runtime. Only needed once, locally, to run supabase/seed.sql against a
# fresh project (see README.md).
# SUPABASE_SERVICE_ROLE_KEY=
